@model prohpharmacy_trekking_app.Services.Email.StaffInvitationEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>You're Invited</title>
</head>
<body style="margin:0;padding:0;background-color:#f0f4f1;font-family:'Segoe UI',Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f1;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;border-radius:10px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td style="background-color:#1a6b3c;padding:36px 40px;text-align:center;">
              <p style="margin:0;font-size:13px;color:#a8d5bc;letter-spacing:2px;text-transform:uppercase;">Proh Pharmacy</p>
              <h1 style="margin:8px 0 0;font-size:26px;color:#ffffff;font-weight:700;letter-spacing:-0.5px;">
                Trekking Operations
              </h1>
              <div style="margin:16px auto 0;width:48px;height:3px;background-color:#c0392b;border-radius:2px;"></div>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:44px 40px 36px;">

              <p style="margin:0 0 8px;font-size:15px;color:#6b7280;">Hello,</p>
              <h2 style="margin:0 0 24px;font-size:22px;color:#1a6b3c;font-weight:700;">
                @Model.StaffFullName
              </h2>

              <p style="margin:0 0 20px;font-size:15px;color:#374151;line-height:1.7;">
                You have been invited to join <strong>@Model.AppName</strong> as a member of the field operations team.
                Click the button below to set your password and activate your account.
              </p>

              <!-- CTA Button -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin:32px 0;">
                <tr>
                  <td align="center">
                    <a href="@Model.InvitationLink"
                       style="display:inline-block;padding:14px 40px;background-color:#1a6b3c;color:#ffffff;
                              text-decoration:none;font-size:15px;font-weight:600;border-radius:6px;
                              letter-spacing:0.3px;">
                      Activate My Account
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Expiry notice -->
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="background-color:#fef2f2;border-left:4px solid #c0392b;border-radius:4px;margin-bottom:28px;">
                <tr>
                  <td style="padding:14px 18px;">
                    <p style="margin:0;font-size:13px;color:#991b1b;font-weight:600;">
                      ⚠ This invitation expires on @Model.ExpiresAt
                    </p>
                    <p style="margin:6px 0 0;font-size:13px;color:#7f1d1d;">
                      If you did not request this, please contact your administrator immediately.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 8px;font-size:13px;color:#6b7280;">
                If the button above doesn't work, copy and paste this link into your browser:
              </p>
              <p style="margin:0;font-size:12px;color:#1a6b3c;word-break:break-all;">
                @Model.InvitationLink
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f8faf9;border-top:1px solid #e5e7eb;padding:24px 40px;text-align:center;">
              <p style="margin:0 0 6px;font-size:12px;color:#9ca3af;">
                Need help? Reach us at
                <a href="mailto:@Model.SupportEmail" style="color:#1a6b3c;text-decoration:none;">@Model.SupportEmail</a>
              </p>
              <p style="margin:0;font-size:11px;color:#d1d5db;">
                &copy; @DateTime.UtcNow.Year Proh Pharmacy · All rights reserved
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
