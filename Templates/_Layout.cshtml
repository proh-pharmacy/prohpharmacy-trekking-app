<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@Model.Title</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6f8;width:100%;margin:0;padding:48px 16px;">
    <tr>
      <td align="center" valign="top">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
               style="max-width:580px;width:100%;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:6px;margin:0 auto;text-align:left;">

          <!-- Header Strip -->
          <tr>
            <td style="padding:20px 38px 0;">
              <div style="padding-bottom:10px;border-bottom:1px solid #e2e8f0;">
                <table cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td valign="middle" style="padding-right:8px;">
                      <img src="https://prohpharmacy.com/images/prohpharmacy_icon.png"
                           alt="Proh Pharmacy"
                           height="24"
                           style="display:block;height:24px;width:auto;border:0;" />
                    </td>
                    <td valign="middle">
                      <span style="font-size:13px;font-weight:600;color:#94a3b8;letter-spacing:-0.2px;">Proh Pharmacy</span>
                      <span style="font-size:13px;color:#94a3b8;margin:0 5px;">&middot;</span>
                      <span style="font-size:13px;font-weight:400;color:#94a3b8;letter-spacing:-0.2px;">@Model.Title</span>
                    </td>
                  </tr>
                </table>
              </div>
            </td>
          </tr>

          <!-- Body Content -->
          <tr>
            <td style="padding:36px 38px 36px;">
              @RenderBody()
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:0 38px 28px;">
              <div style="border-top:1px solid #e5e7eb;padding-top:20px;">
                <p style="margin:0;font-size:11px;color:#94a3b8;line-height:1.5;font-weight:400;">
                  &copy; @Model.Year @Model.AppName &middot; Proh Pharmacy &middot; All rights reserved
                </p>
              </div>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
