@model prohpharmacy_trekking_app.Services.Email.StaffWelcomeEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Welcome to @Model.AppName</title>
</head>
<body style="margin:0;padding:0;background-color:#f0f4f1;font-family:'Segoe UI',Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f4f1;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;border-radius:10px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td style="background-color:#1a6b3c;padding:36px 40px;text-align:center;">
              <p style="margin:0;font-size:13px;color:#a8d5bc;letter-spacing:2px;text-transform:uppercase;">Proh Pharmacy</p>
              <h1 style="margin:8px 0 0;font-size:26px;color:#ffffff;font-weight:700;letter-spacing:-0.5px;">
                Trekking Operations
              </h1>
              <div style="margin:16px auto 0;width:48px;height:3px;background-color:#c0392b;border-radius:2px;"></div>
            </td>
          </tr>

          <!-- Welcome Banner -->
          <tr>
            <td style="background-color:#e8f5ee;padding:20px 40px;text-align:center;border-bottom:1px solid #c6e6d4;">
              <p style="margin:0;font-size:16px;color:#1a6b3c;font-weight:600;">
                🎉 Welcome aboard, @Model.StaffFullName!
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:40px 40px 32px;">

              <p style="margin:0 0 20px;font-size:15px;color:#374151;line-height:1.7;">
                Your account on <strong>@Model.AppName</strong> has been created by an administrator.
                Below are your login credentials to get started.
              </p>

              <!-- Credentials Box -->
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="background-color:#f8faf9;border:1px solid #d1e8da;border-radius:8px;margin-bottom:28px;">
                <tr>
                  <td style="padding:24px 28px;">
                    <p style="margin:0 0 4px;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:1px;">Employee Number</p>
                    <p style="margin:0 0 20px;font-size:18px;color:#1a6b3c;font-weight:700;letter-spacing:1px;">@Model.EmployeeNumber</p>

                    <p style="margin:0 0 4px;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:1px;">Email</p>
                    <p style="margin:0 0 20px;font-size:15px;color:#374151;font-weight:600;">@Model.Email</p>

                    <p style="margin:0 0 4px;font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:1px;">Initial Password</p>
                    <p style="margin:0;font-size:18px;color:#c0392b;font-weight:700;font-family:monospace;letter-spacing:2px;">@Model.InitialPassword</p>
                  </td>
                </tr>
              </table>

              <!-- Warning -->
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="background-color:#fef2f2;border-left:4px solid #c0392b;border-radius:4px;margin-bottom:32px;">
                <tr>
                  <td style="padding:14px 18px;">
                    <p style="margin:0;font-size:13px;color:#991b1b;font-weight:600;">
                      ⚠ Change your password after first login
                    </p>
                    <p style="margin:6px 0 0;font-size:13px;color:#7f1d1d;line-height:1.6;">
                      This is a system-generated password. For your security, please update it immediately after signing in.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- CTA Button -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:28px;">
                <tr>
                  <td align="center">
                    <a href="@Model.LoginUrl"
                       style="display:inline-block;padding:14px 40px;background-color:#1a6b3c;color:#ffffff;
                              text-decoration:none;font-size:15px;font-weight:600;border-radius:6px;
                              letter-spacing:0.3px;">
                      Sign In Now
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Getting Started Checklist -->
              <p style="margin:0 0 12px;font-size:14px;font-weight:700;color:#374151;">Getting started:</p>
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding:6px 0;">
                    <span style="color:#1a6b3c;font-weight:700;margin-right:8px;">✓</span>
                    <span style="font-size:14px;color:#4b5563;">Sign in with your credentials above</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding:6px 0;">
                    <span style="color:#1a6b3c;font-weight:700;margin-right:8px;">✓</span>
                    <span style="font-size:14px;color:#4b5563;">Change your password immediately</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding:6px 0;">
                    <span style="color:#1a6b3c;font-weight:700;margin-right:8px;">✓</span>
                    <span style="font-size:14px;color:#4b5563;">Review your assigned branch and role</span>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f8faf9;border-top:1px solid #e5e7eb;padding:24px 40px;text-align:center;">
              <p style="margin:0 0 6px;font-size:12px;color:#9ca3af;">
                Need help? Reach us at
                <a href="mailto:@Model.SupportEmail" style="color:#1a6b3c;text-decoration:none;">@Model.SupportEmail</a>
              </p>
              <p style="margin:0;font-size:11px;color:#d1d5db;">
                &copy; @DateTime.UtcNow.Year Proh Pharmacy · All rights reserved
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
