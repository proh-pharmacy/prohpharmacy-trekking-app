@model prohpharmacy_trekking_app.Services.Email.StaffWelcomeEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Welcome to @Model.AppName</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;">

  <!-- Outer Backdrop (centers email in the middle with soft neutral canvas) -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6f8;width:100%;margin:0;padding:48px 16px;">
    <tr>
      <td align="center" valign="top">

        <!-- Centered Email Container (580px width, clean border, NO box shadows) -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
               style="max-width:580px;width:100%;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:6px;margin:0 auto;text-align:left;">
          <tr>
            <td style="padding:42px 38px 36px;">

              <!-- Brand Header -->
              <p style="margin:0 0 14px;font-size:11px;font-weight:600;color:#00bf6f;letter-spacing:1px;text-transform:uppercase;">
                @Model.AppName
              </p>

              <!-- Main Heading -->
              <h1 style="margin:0 0 14px;font-size:24px;font-weight:600;color:#4b5563;letter-spacing:-0.3px;line-height:1.3;">
                Welcome @Model.StaffFullName
              </h1>

              <!-- Intro Paragraph -->
              <p style="margin:0 0 26px;font-size:14.5px;color:#475569;line-height:1.65;font-weight:400;">
                Your account on <span style="color:#4b5563;font-weight:500;">@Model.AppName</span> has been created by an administrator. Below are your login credentials to get started.
              </p>

              <!-- Feature Card (Clean Green Border with Subtle Green Tint - NO box shadows) -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="border:1.5px solid #00bf6f;border-radius:4px;background-color:#f2faf5;margin-bottom:28px;">
                <tr>
                  <td style="padding:24px 24px 18px;">

                    <!-- Card Subheading -->
                    <p style="margin:0 0 16px;font-size:16px;font-weight:600;color:#4b5563;">
                      Account Credentials
                    </p>

                    <!-- Account Details 2-Column Table (Label | Value) -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;margin-bottom:16px;">
                      <tr>
                        <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;width:36%;">
                          Full Name
                        </td>
                        <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#4b5563;font-weight:500;">
                          @Model.StaffFullName
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;">
                          Employee ID
                        </td>
                        <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#4b5563;font-weight:500;">
                          @Model.EmployeeNumber
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;">
                          Work Email
                        </td>
                        <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#4b5563;font-weight:400;">
                          @Model.Email
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:10px 8px;font-size:13.5px;color:#64748b;font-weight:500;">
                          Temporary Password
                        </td>
                        <td style="padding:10px 8px;font-size:13.5px;color:#4b5563;">
                          <span style="font-family:monospace;color:#ea580c;border-bottom:1.5px dotted #ea580c;padding-bottom:1px;font-size:13.5px;font-weight:500;letter-spacing:0.5px;">@Model.InitialPassword</span>
                          <span style="font-size:12px;color:#64748b;margin-left:6px;">(change after first sign in)</span>
                        </td>
                      </tr>
                    </table>

                    <!-- Security Notice (Ultra-subtle red tint background, red foreground, NO left border, NO icon) -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0"
                           style="background-color:#fff8f8;border-radius:4px;margin:14px 0 18px;">
                      <tr>
                        <td style="padding:11px 14px;">
                          <p style="margin:0;font-size:13px;color:#b91c1c;line-height:1.5;font-weight:400;">
                            <span style="font-weight:500;">Security notice:</span> This is a system-generated password. For your security, please update it immediately after signing in.
                          </p>
                        </td>
                      </tr>
                    </table>

                    <!-- Divider -->
                    <div style="border-top:1px solid #d6ece0;margin:16px 0 14px;"></div>

                    <!-- Bottom Bar (Username & Sign In Button) -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td valign="middle" style="font-size:13.5px;color:#64748b;font-weight:400;">
                          Your username: <span style="color:#4b5563;font-weight:500;">@Model.EmployeeNumber</span>
                        </td>
                        <td align="right" valign="middle">
                          <a href="@Model.LoginUrl"
                             style="display:inline-block;padding:9px 22px;background-color:#00bf6f;color:#ffffff;text-decoration:none;font-size:13.5px;font-weight:500;border-radius:3px;">
                            Sign In
                          </a>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- Footer -->
              <div style="border-top:1px solid #e5e7eb;padding-top:20px;">
                <p style="margin:0 0 6px;font-size:12px;color:#64748b;font-weight:400;">
                  Need help? Reach us at <a href="mailto:@Model.SupportEmail" style="color:#00bf6f;text-decoration:none;font-weight:500;">@Model.SupportEmail</a>
                </p>
                <p style="margin:0;font-size:11px;color:#94a3b8;line-height:1.5;font-weight:400;">
                  &copy; @Model.Year @Model.AppName · Proh Pharmacy · All rights reserved
                </p>
              </div>

            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

</body>
</html>
