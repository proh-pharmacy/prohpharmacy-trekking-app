@model prohpharmacy_trekking_app.Services.Email.StaffWelcomeEmailModel
@{ Layout = "_Layout.cshtml"; }

<p style="margin:0 0 26px;font-size:14.5px;color:#64748b;line-height:1.65;font-weight:400;">
  Your account has been created.
</p>

<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border:1.5px solid #00bf6f;border-radius:4px;background-color:#f2faf5;margin-bottom:28px;">
  <tr>
    <td style="padding:24px 24px 18px;">

      <p style="margin:0 0 16px;font-size:16px;font-weight:600;color:#64748b;">
        Account Credentials
      </p>

      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;margin-bottom:16px;">
        <tr>
          <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;width:36%;">
            Full Name
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;">
            @Model.StaffFullName
          </td>
        </tr>
        <tr>
          <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;">
            Employee ID
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;">
            @Model.EmployeeNumber
          </td>
        </tr>
        <tr>
          <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:500;">
            Work Email
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #e2f0e8;font-size:13.5px;color:#64748b;font-weight:400;">
            @Model.Email
          </td>
        </tr>
        <tr>
          <td style="padding:10px 8px;font-size:13.5px;color:#64748b;font-weight:500;">
            Temporary Password
          </td>
          <td style="padding:10px 8px;font-size:13.5px;color:#64748b;">
            <span style="font-family:monospace;color:#ea580c;border-bottom:1.5px dotted #ea580c;padding-bottom:1px;font-size:13.5px;font-weight:500;letter-spacing:0.5px;">@Model.InitialPassword</span>
            <span style="font-size:12px;color:#64748b;margin-left:6px;">(change after first sign in)</span>
          </td>
        </tr>
      </table>

      <table width="100%" cellpadding="0" cellspacing="0" border="0"
             style="background-color:#fff8f8;border-radius:4px;margin:14px 0 18px;">
        <tr>
          <td style="padding:11px 14px;">
            <p style="margin:0;font-size:13px;color:#b91c1c;line-height:1.5;font-weight:400;">
              <span style="font-weight:500;">Security notice:</span> This is a system-generated password. For your security, please update it immediately after signing in.
            </p>
          </td>
        </tr>
      </table>

      <div style="border-top:1px solid #d6ece0;margin:16px 0 14px;"></div>

      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td valign="middle" style="font-size:13.5px;color:#64748b;font-weight:400;">
            Your username: <span style="color:#64748b;font-weight:500;">@Model.EmployeeNumber</span>
          </td>
          <td align="right" valign="middle">
            <a href="@Model.LoginUrl"
               style="display:inline-block;padding:9px 22px;background-color:#00bf6f;color:#ffffff;text-decoration:none;font-size:13.5px;font-weight:500;border-radius:3px;">
              Sign In
            </a>
          </td>
        </tr>
      </table>

    </td>
  </tr>
</table>
