{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_PG_USERNAME;Password=YOUR_PG_PASSWORD"
  },
  "SiteSettings": {
    "AppName": "Proh Pharmacy Trekking",
    "AppKey": "REPLACE_WITH_A_SECURE_BASE64_KEY_AT_LEAST_32_CHARS",
    "FrontendUrl": "https://yourapp.com"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "noreply@prohpharmacy.com",
    "FromName": "Proh Pharmacy",
    "SupportEmail": "support@prohpharmacy.com"
  },
  "JwtSettings": {
    "validIssuer": "PROHPHARMACY-TREKKING",
    "validAudience": "https://localhost:7001",
    "expire": "3200"
  },
  "TraccarSettings": {
    "BaseUrl": "https://tracking.prohpharmacy.com",
    "Username": "YOUR_TRACCAR_USERNAME",
    "Password": "YOUR_TRACCAR_PASSWORD",
    "WebhookSecret": "REPLACE_WITH_A_RANDOM_SECRET"
  },
  "ImageKitSettings": {
    "PrivateKey": "YOUR_IMAGEKIT_PRIVATE_KEY"
  },
  "Pagination": {
    "PublicBaseUrl": ""
  },
  "DocumentMatching": {
    "OcrBaseUrl": "http://localhost:8091/",
    "MaxFiles": 5,
    "MaxFileBytes": 10485760,
    "MaxTotalBytes": 20971520,
    "MaxPages": 20,
    "MaxRowsPerFile": 1000,
    "MaxTextLength": 1000,
    "ProcessingTimeoutSeconds": 180,
    "MaxConcurrentRequests": 2,
    "MinimumSimilarity": 75,
    "AmbiguityMargin": 5,
    "MaxCandidates": 5,
    "OcrTimeoutSeconds": 60
  },
  "PathBase": ""
}
