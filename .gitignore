## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# NuGet Packages
*.nupkg
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# Except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# NuGet v3's project.json files
*.nuspec
project.lock.json
project.fragment.lock.json
artifacts/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.meta

# Rider
.idea/

# VSCode
.vscode/

# Rider / JetBrains
.idea/
*.sln.iml

# Mac
.DS_Store
**/.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# dotnet user secrets
secrets.json

# dotnet ef migrations (keep Migrations folder, ignore generated scripts)
*.mssql

# Publish output
publish/
